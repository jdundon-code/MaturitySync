# MaturitySync — Environment Configuration
# Copy this file to .env and update values for your environment

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/maturitysync

# API Server
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# CORS (comma-separated origins, or * for development)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Digital Banking Platform (DBP) Integration
# In production, replace with your DBP's API credentials
DBP_BASE_URL=http://localhost:3001/mock-dbp
DBP_API_KEY=
DBP_TENANT_ID=

# Notification Service (Phase 2)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# PUSH_SERVICE_URL=
# PUSH_SERVICE_KEY=
